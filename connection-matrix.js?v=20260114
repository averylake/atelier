// ===== ANALYSIS FUNCTIONS =====

/**
 * Analyze user selections and generate connections
 */
function analyzeSelections(colorKey, shapeKey, number, zodiacKey) {
    const color = COLORS[colorKey];
    const shape = SHAPES[shapeKey];
    const num = NUMBERS[number];
    const zod = ZODIAC[zodiacKey];

    return {
        color: { key: colorKey, ...color },
        shape: { key: shapeKey, ...shape },
        number: { value: number, ...num },
        zodiac: { key: zodiacKey, ...zod },
        harmony: calculateHarmony(colorKey, shapeKey, number, zodiacKey),
        meaning: generateMeaning(colorKey, shapeKey, number, zodiacKey)
    };
}

/**
 * Calculate harmony between selections (0-100)
 */
function calculateHarmony(colorKey, shapeKey, number, zodiacKey) {
    let harmonyScore = 50; // Base score

    const color = COLORS[colorKey];
    const shape = SHAPES[shapeKey];
    const num = NUMBERS[number];
    const zod = ZODIAC[zodiacKey];

    // Perfect Kandinsky pairing: shape's color affinity matches selected color
    if (shape.colorAffinity === colorKey) {
        harmonyScore += 20;
    }

    // Element matching
    if (color.element === num.element) {
        harmonyScore += 10;
    }

    // Zodiac color match
    if (zod.colorAffinity === colorKey) {
        harmonyScore += 15;
    }

    // Zodiac number alignment
    if (zod.number === number) {
        harmonyScore += 15;
    }

    // Temperature harmony (opposites create tension, same creates calm)
    if (color.temperature === shape.temperature) {
        harmonyScore += 10;
    }

    return Math.min(100, harmonyScore);
}

/**
 * Generate meaning text based on selections
 */
function generateMeaning(colorKey, shapeKey, number, zodiacKey) {
    const color = COLORS[colorKey];
    const shape = SHAPES[shapeKey];
    const num = NUMBERS[number];
    const zod = ZODIAC[zodiacKey];

    const harmony = calculateHarmony(colorKey, shapeKey, number, zodiacKey);

    let interpretation = '';

    // Opening based on harmony
    if (harmony >= 80) {
        interpretation = 'A highly harmonious composition emerges. ';
    } else if (harmony >= 60) {
        interpretation = 'A balanced composition with dynamic tensions. ';
    } else {
        interpretation = 'A composition of creative tension and contrast. ';
    }

    // Color-shape relationship
    if (shape.colorAffinity === colorKey) {
        interpretation += `The ${shape.name} finds its ideal expression in ${color.name}, as Kandinsky proposed. `;
    } else {
        interpretation += `The ${shape.name} meets ${color.name} in unexpected dialogue. `;
    }

    // Numerological layer
    interpretation += `Through the number ${number}, the energy of ${num.quality.toLowerCase()} flows—${num.meaning.toLowerCase()}. `;

    // Zodiac synthesis
    interpretation += `Under ${zod.name}, the ${zod.element.toLowerCase()} element guides this combination toward ${shape.meaning.toLowerCase()}.`;

    return interpretation;
}

/**
 * Get artifact ID (timestamp-based)
 * Format: KA-[timestamp] (Kandinsky Atelier)
 */
function getArtifactID() {
    return `KA-${Date.now()}`;
}
