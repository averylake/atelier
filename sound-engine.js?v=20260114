// ===== COLOR-TO-SOUND MAPPING =====

const COLOR_SOUNDS = {
    red: playRedSound,
    orange: playOrangeSound,
    yellow: playYellowSound,
    yellowGreen: playYellowGreenSound,
    green: playGreenSound,
    blueGreen: playBlueGreenSound,
    cyan: playCyanSound,
    blue: playBlueSound,
    violet: playVioletSound,
    magenta: playMagentaSound,
    white: playWhiteSound,
    black: playBlackSound
};

// ===== PUBLIC API =====

/**
 * Play the synesthetic sound for a given color
 * @param {string} colorKey - Key from COLORS object (e.g., 'red', 'blue')
 */
function playColorSound(colorKey) {
    if (COLOR_SOUNDS[colorKey]) {
        COLOR_SOUNDS[colorKey]();
    } else {
        console.warn(`No sound defined for color: ${colorKey}`);
    }
}

/**
 * Play a harmonic chord of the selected color (for final generation)
 * @param {string} colorKey - Key from COLORS object
 */
function playGenerationSound(colorKey) {
    if (COLOR_SOUNDS[colorKey]) {
        // Play the main sound
        COLOR_SOUNDS[colorKey]();

        // Add a harmonic overtone after slight delay for richness
        setTimeout(() => {
            COLOR_SOUNDS[colorKey]();
        }, 150);
    }
}
