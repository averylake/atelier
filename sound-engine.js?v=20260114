/**
 * THE KANDINSKY ATELIER - SYNESTHETIC SOUND ENGINE
 * 
 * Implements Kandinsky's color-sound synesthesia using Web Audio API
 * Each of the 12 colors has a unique synthesized musical tone
 * Based on Kandinsky's spiritual theories of art
 */

// ===== AUDIO CONTEXT SETUP =====
let audioContext;
let masterGain;
let reverbNode;

// Initialize audio context (must be called after user interaction on some browsers)
function initAudioContext() {
    if (!audioContext) {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();

        // Create master gain (volume control)
        masterGain = audioContext.createGain();
        masterGain.gain.value = 0.3; // Moderate volume

        // Create simple reverb using convolver
        reverbNode = audioContext.createGain();
        reverbNode.gain.value = 0.2; // Subtle reverb

        // Connect reverb to master output
        reverbNode.connect(masterGain);
        masterGain.connect(audioContext.destination);
    }

    // Resume context if suspended (Safari requirement)
    if (audioContext.state === 'suspended') {
        audioContext.resume();
    }
}

// ===== SOUND GENERATOR FUNCTIONS =====

/**
 * RED - Trumpet, drums (Bold, brass C5 523Hz)
 */
function playRedSound() {
    initAudioContext();

    const osc = audioContext.createOscillator();
    const gain = audioContext.createGain();

    osc.type = 'sawtooth'; // Brass timbre
    osc.frequency.value = 523; // C5

    // ADSR Envelope - punchy attack for trumpet
    const now = audioContext.currentTime;
    gain.gain.setValueAtTime(0, now);
    gain.gain.linearRampToValueAtTime(0.6, now + 0.02); // Fast attack
    gain.gain.exponentialRampToValueAtTime(0.3, now + 0.15); // Sustain
    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4); // Release

    osc.connect(gain);
    gain.connect(reverbNode);
    gain.connect(masterGain);

    osc.start(now);
    osc.stop(now + 0.4);
}

