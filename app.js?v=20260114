// ===== HELPERS =====

function lighten(hex, percent) {
    const num = parseInt(hex.replace('#', ''), 16);
    const amt = Math.round(2.55 * percent);
    const R = (num >> 16) + amt;
    const G = (num >> 8 & 0x00FF) + amt;
    const B = (num & 0x0000FF) + amt;
    return '#' + (0x1000000 + (R < 255 ? R < 1 ? 0 : R : 255) * 0x10000 +
        (G < 255 ? G < 1 ? 0 : G : 255) * 0x100 +
        (B < 255 ? B < 1 ? 0 : B : 255))
        .toString(16).slice(1);
}

function smoothScrollToSection(sectionName) {
    // Map section names to data-section values
    const sectionMap = {
        'color': 'colors',
        'shape': 'shapes',
        'number': 'numbers',
        'zodiac': 'zodiac'
    };

    const targetSection = sectionMap[sectionName] || sectionName;
    const element = document.querySelector(`[data-section="${targetSection}"]`);

    if (element) {
        // Show the target section
        element.style.display = '';

        // Scroll to it
        setTimeout(() => {
            element.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 100);
    }
}

// Draw shape preview with all 12 biomorphic forms
function drawShapePreview(canvas, shapeKey) {
    const ctx = canvas.getContext('2d');
    const size = 80;
    const x = 75;
    const y = 75;

    ctx.strokeStyle = '#FFFFFF';
    ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';
    ctx.lineWidth = 3;
    ctx.lineCap = 'round';

    switch (shapeKey) {
        case 'cell':
            ctx.beginPath();
            ctx.arc(x, y, size / 2, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
            ctx.beginPath();
            ctx.arc(x + size / 6, y - size / 6, size / 6, 0, Math.PI * 2);
            ctx.fill();
            break;

        case 'amoeba':
            ctx.beginPath();
            for (let i = 0; i <= 8; i++) {
                const angle = (i / 8) * Math.PI * 2;
                const r = (size / 2) * (0.7 + Math.sin(i) * 0.3);
                const px = x + Math.cos(angle) * r;
                const py = y + Math.sin(angle) * r;
                if (i === 0) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            }
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
            break;

        case 'pod':
            ctx.beginPath();
            ctx.ellipse(x, y, size / 3, size / 2, Math.PI / 4, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
            break;

        case 'tendril':
            ctx.beginPath();
            ctx.moveTo(x - size / 2, y + size / 2);
            ctx.quadraticCurveTo(x, y - size / 2, x + size / 2, y);
            ctx.lineWidth = 4;
            ctx.stroke();
            break;

        case 'blob':
            ctx.beginPath();
            ctx.moveTo(x + size / 2, y);
            ctx.bezierCurveTo(x + size / 2, y - size / 3, x + size / 4, y - size / 2, x, y - size / 2);
            ctx.bezierCurveTo(x - size / 4, y - size / 2, x - size / 2, y - size / 3, x - size / 2, y);
            ctx.bezierCurveTo(x - size / 2, y + size / 3, x - size / 4, y + size / 2, x, y + size / 2);
            ctx.bezierCurveTo(x + size / 4, y + size / 2, x + size / 2, y + size / 3, x + size / 2, y);
            ctx.fill();
            ctx.stroke();
            break;

        case 'nucleus':
            ctx.beginPath();
            ctx.arc(x, y, size / 3, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
            for (let i = 0; i < 4; i++) {
                const angle = (i / 4) * Math.PI * 2;
                ctx.beginPath();
                ctx.arc(x + Math.cos(angle) * size / 2.2, y + Math.sin(angle) * size / 2.2, size / 12, 0, Math.PI * 2);
                ctx.fill();
            }
            break;

        case 'membrane':
            ctx.beginPath();
            ctx.arc(x, y, size / 2, 0, Math.PI * 2);
            ctx.stroke();
            ctx.beginPath();
            ctx.arc(x, y, size / 3, 0, Math.PI * 2);
            ctx.stroke();
            break;

        case 'spore':
            ctx.beginPath();
            ctx.arc(x, y - size / 4, size / 3, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(x, y);
            ctx.quadraticCurveTo(x + size / 6, y + size / 3, x, y + size / 2);
            ctx.stroke();
            break;

        case 'cyst':
            ctx.globalAlpha = 0.7;
            ctx.beginPath();
            ctx.ellipse(x, y, size / 2.2, size / 2.5, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.globalAlpha = 1;
            ctx.stroke();
            break;

        case 'embryo':
            ctx.beginPath();
            ctx.arc(x, y, size / 2, 0, Math.PI * 2);
            ctx.stroke();
            ctx.beginPath();
            ctx.arc(x - size / 8, y, size / 3, 0, Math.PI * 2);
            ctx.stroke();
            break;

        case 'flagellum':
            ctx.beginPath();
            ctx.moveTo(x - size / 2, y);
            ctx.bezierCurveTo(x - size / 4, y - size / 3, x, y + size / 3, x + size / 4, y);
            ctx.bezierCurveTo(x + size / 3, y - size / 4, x + size / 2, y + size / 4, x + size / 2, y);
            ctx.lineWidth = 4;
            ctx.stroke();
            break;

        case 'chromosome':
            ctx.beginPath();
            ctx.moveTo(x - size / 3, y - size / 3);
            ctx.quadraticCurveTo(x, y, x + size / 3, y + size / 3);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(x + size / 3, y - size / 3);
            ctx.quadraticCurveTo(x, y, x - size / 3, y + size / 3);
            ctx.stroke();
            break;

        default:
            ctx.beginPath();
            ctx.arc(x, y, size / 2, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
    }
}

// ===== GENERATE FINAL ARTWORK =====

function generateFinalArtwork() {
    // Generate deterministic artifact ID
    state.artifactID = getArtifactID();

    // Hide all sections and show result
    document.querySelectorAll('section').forEach(s => s.style.display = 'none');
    document.getElementById('result-section').style.display = 'flex';

    // Update artifact title with hash
    const titleEl = document.getElementById('artwork-title');
    if (titleEl) {
        titleEl.textContent = `Atelier K ${state.artifactID}`;
    }

    // Scroll to result
    window.scrollTo({ top: 0, behavior: 'smooth' });

    // Generate artwork
    setTimeout(() => {
        const analysis = analyzeSelections(state.color, state.shape, state.number, state.zodiac);
        const finalCanvas = document.getElementById('final-canvas');
        const generator = new KandinskyGenerator(finalCanvas, analysis);
        generator.generate();

        playGenerationSound(state.color);

        // Hide legend button (user is done with journey)
        document.getElementById('legend-toggle').style.display = 'none';

        // Populate live editor instead of data panel immediately
        populateLiveEditors();

        setTimeout(() => {
            finalCanvas.classList.add('visible');
        }, 200);
    }, 500);
}

