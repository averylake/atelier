// ===== PARTICLE SYSTEM =====
const canvas = document.getElementById('particle-canvas');
const ctx = canvas.getContext('2d');
let particles = [];
let mouseParticles = [];

function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}
resizeCanvas();
window.addEventListener('resize', resizeCanvas);

class Particle {
    constructor(x, y, color = null) {
        this.x = x || Math.random() * canvas.width;
        this.y = y || Math.random() * canvas.height;
        this.vx = (Math.random() - 0.5) * 0.5;
        this.vy = (Math.random() - 0.5) * 0.5;
        this.size = Math.random() * 2 + 1;
        this.alpha = Math.random() * 0.5 + 0.3;
        this.color = color || `hsl(${Math.random() * 360}, 70%, 60%)`;
        this.life = 1;
        this.decay = Math.random() * 0.005 + 0.002;
    }

    update() {
        this.x += this.vx;
        this.y += this.vy;
        this.life -= this.decay;

        if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
        if (this.y < 0 || this.y > canvas.height) this.vy *= -1;
    }

    draw() {
        ctx.globalAlpha = this.alpha * this.life;
        ctx.fillStyle = this.color;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 1;
    }
}

// Initialize particles
for (let i = 0; i < 100; i++) {
    particles.push(new Particle());
}

function animateParticles() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Update and draw background particles
    particles = particles.filter(p => p.life > 0);
    particles.forEach(p => {
        p.update();
        p.draw();
    });

    // Add new particles if needed
    while (particles.length < 100) {
        particles.push(new Particle());
    }

    // Mouse particles
    mouseParticles = mouseParticles.filter(p => p.life > 0);
    mouseParticles.forEach(p => {
        p.update();
        p.draw();
    });

    requestAnimationFrame(animateParticles);
}
animateParticles();

// Create particle explosion on mouse move
let lastParticleTime = 0;
document.addEventListener('mousemove', (e) => {
    const now = Date.now();
    if (now - lastParticleTime > 50) {
        for (let i = 0; i < 3; i++) {
            mouseParticles.push(new Particle(e.clientX, e.clientY));
        }
        lastParticleTime = now;
    }
});

// ===== SCROLL ANIMATIONS =====
const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -100px 0px'
};

const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.classList.add('visible');
        }
    });
}, observerOptions);

// Observe all animatable elements
document.querySelectorAll('.section-title, .color-orb, .shape-container, .number-item, .zodiac-item').forEach(el => {
    observer.observe(el);
});

// ===== POPULATE GRIDS =====

function populateColors() {
    const grid = document.getElementById('color-grid');
    const colorKeys = Object.keys(COLORS);

    colorKeys.forEach((key, index) => {
        const color = COLORS[key];
        const orb = document.createElement('div');
        orb.className = 'color-orb';
        orb.style.background = `radial-gradient(circle at 30% 30%, ${lighten(color.hex, 20)}, ${color.hex})`;
        orb.style.transitionDelay = `${index * 0.05}s`;

        orb.addEventListener('click', () => selectColor(key, orb));
        orb.addEventListener('mouseenter', () => {
            playColorSound(key);
            createColorExplosion(orb, color.hex);
        });

        observer.observe(orb);
        grid.appendChild(orb);
    });
}

function populateShapes() {
    const grid = document.getElementById('shape-grid');
    const shapeKeys = Object.keys(SHAPES);

    shapeKeys.forEach((key, index) => {
        const container = document.createElement('div');
