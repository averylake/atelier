    if (zodiacNameEl) zodiacNameEl.textContent = zodiacElement;
}

function getComplexityLabel(percent) {
    if (percent < 40) return 'Minimal';
    if (percent < 60) return 'Balanced';
    if (percent < 80) return 'Rich';
    return 'Dense';
}



