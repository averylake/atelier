const sectionOrder = ['hero', 'colors', 'shapes', 'numbers', 'zodiac', 'result'];

function navigateToSection(sectionName) {
    if (state.isTransitioning) return;

    state.isTransitioning = true;
    state.currentSection = sectionName;

    // Get all sections and find target
    const sections = document.querySelectorAll('section');
    const targetSection = document.querySelector(`[data-section="${sectionName}"]`);
    const scrollContainer = document.querySelector('.scroll-container');

    if (!targetSection || !scrollContainer) {
        console.error(`Section '${sectionName}' not found.`);
        state.isTransitioning = false;
        return;
    }

    // Find target index
    let targetIndex = 0;
    sections.forEach((sec, index) => {
        if (sec === targetSection) {
            targetIndex = index;
        }
        sec.classList.remove('active');
    });

    // Move container using translateY (each section is 100vh)
    scrollContainer.style.transform = `translateY(-${targetIndex * 100}vh)`;

    // Activate target section
    targetSection.classList.add('active');

    // Populate section-specific legend
    populateSectionLegend(sectionName);

    // Allow transitions after animation
    setTimeout(() => {
        state.isTransitioning = false;
    }, 800);
}

function unlockNextSection() {
    const currentIndex = sectionOrder.indexOf(state.currentSection);
    if (currentIndex < sectionOrder.length - 1) {
        const nextSection = sectionOrder[currentIndex + 1];
        if (!state.unlockedSections.includes(nextSection)) {
            state.unlockedSections.push(nextSection);
        }
    }
}

function advanceToNextSection() {
    const currentIndex = sectionOrder.indexOf(state.currentSection);
    if (currentIndex < sectionOrder.length - 1) {
        const nextSection = sectionOrder[currentIndex + 1];
        unlockNextSection();

        // Smooth delay before transition
        setTimeout(() => {
            navigateToSection(nextSection);
        }, 600);
    }
}


