    if (livingIndicator) livingIndicator.style.display = 'none';

    const finalActions = document.getElementById('final-actions');
    if (finalActions) finalActions.style.display = 'none';

    const dataPanel = document.getElementById('data-panel');
    if (dataPanel) dataPanel.style.display = 'none';

    const dataIntro = document.getElementById('data-intro');
    if (dataIntro) dataIntro.style.display = 'none';

    // Clear canvas
    const canvas = document.getElementById('final-canvas');
    if (canvas) {
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    // Navigate back to hero
    navigateToSection('hero');
    flashMessage('SYSTEM RESET // NEW SIGNAL AWAITED');
}

