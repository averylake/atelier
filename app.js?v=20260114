    if (harmonyBar) harmonyBar.style.width = `${harmonyValue}%`;

    // Complexity based on number (1-12 maps to 20-100%)
    const complexityPercent = Math.round(20 + (state.number / 12) * 80);
    const complexityEl = document.getElementById('metric-complexity-value');
    const complexityBar = document.getElementById('metric-complexity-bar');
    if (complexityEl) complexityEl.textContent = getComplexityLabel(complexityPercent);
    if (complexityBar) complexityBar.style.width = `${complexityPercent}%`;

    // Temperature based on color
    const colorData = COLORS[state.color];
    const tempValue = colorData?.temperature || 'Neutral';
    const tempEl = document.getElementById('metric-temp-value');
    const tempIndicator = document.getElementById('metric-temp-indicator');
    if (tempEl) tempEl.textContent = tempValue;
    if (tempIndicator) {
        const tempPosition = tempValue === 'Warm' ? '80%' : tempValue === 'Cool' ? '20%' : '50%';
        tempIndicator.style.left = tempPosition;
    }

    // Elements
    const elementIcons = { Fire: '🔥', Water: '💧', Earth: '🌍', Air: '💨' };
    const colorElement = colorData?.element || 'Fire';
    const zodiacElement = ZODIAC[state.zodiac]?.element || 'Water';

    const colorIconEl = document.getElementById('element-color-icon');
    const colorNameEl = document.getElementById('element-color-name');
    if (colorIconEl) colorIconEl.textContent = elementIcons[colorElement] || '🔴';
    if (colorNameEl) colorNameEl.textContent = colorElement;

    const zodiacIconEl = document.getElementById('element-zodiac-icon');
