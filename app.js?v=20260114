function generateDeterministicHash(color, shape, number, zodiac) {
    const input = `${color}-${shape}-${number}-${zodiac}`;
    let hash = 0;
    for (let i = 0; i < input.length; i++) {
        hash = ((hash << 5) - hash) + input.charCodeAt(i);
        hash = hash & hash;
    }
    return `AK${Math.abs(hash).toString(36).toUpperCase().padStart(8, '0')}`;
}

