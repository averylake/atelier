/**
 * THE KANDINSKY ATELIER - BIOMORPHIC ART ENGINE
 * 
 * Creates organic, fluid compositions based on user selections
 * Inspired by Kandinsky's Paris Period (1933-1944):
 * - Soft, microscopic biomorphic forms
 * - Translucent washes and color fields
 * - Scratchy, expressive linear accents
 * - Cell-like, amoebic shapes
 * 
 * DETERMINISTIC: Same selections = same artwork (seeded randomness)
 */

// Seeded Random Number Generator (for deterministic art)
class SeededRandom {
    constructor(seed) {
        this.seed = seed % 2147483647;
        if (this.seed <= 0) this.seed += 2147483646;
    }

    next() {
        this.seed = (this.seed * 16807) % 2147483647;
        return (this.seed - 1) / 2147483646;
    }
}

class KandinskyGenerator {
    constructor(canvas, selections) {
        this.canvas = canvas;
        this.ctx = canvas.getContext('2d');
        this.selections = selections;
        this.width = canvas.width;
        this.height = canvas.height;

        // Create deterministic seed from selections
        const seedString = `${selections.color.key}-${selections.shape.key}-${selections.number.value}-${selections.zodiac.key}`;
        const seed = this.hashCode(seedString);
        this.rng = new SeededRandom(seed);
    }

    // Hash function to create seed from combination
    hashCode(str) {
        let hash = 0;
        for (let i = 0; i < str.length; i++) {
            const char = str.charCodeAt(i);
            hash = ((hash << 5) - hash) + char;
            hash = hash & hash; // Convert to 32bit integer
        }
        return Math.abs(hash);
    }

    // Use seeded random instead of this.random()
    random() {
        return this.rng.next();
    }

    /**
     * Generate the complete artwork - 7 LAYER SYSTEM (Paris Period)
     * Creates fluid, biomorphic compositions with organic forms
     */
    generate() {
        // Clear canvas with off-white background
        this.ctx.fillStyle = '#F5F5F0';
        this.ctx.fillRect(0, 0, this.width, this.height);

        // LAYER 0: Paper grain texture base
        this.drawPaperGrain();

        // Build color palette from selections
        const palette = this.buildPalette();
        const compositionStyle = this.getCompositionStyle();

        // LAYER 1: Soft wash backgrounds (3-5 large translucent fields)
        this.drawColorWashes(palette);

        // LAYER 2: Large biomorphic zones (5-8 major organic shapes)
        this.drawLargeOrganicForms(palette, compositionStyle);

        // LAYER 3: Primary biomorphic forms (hero element + variations)
        this.drawPrimaryBiomorphicForms(palette, compositionStyle);

        // LAYER 4: Cell clusters (20-40 smaller organic blobs)
        this.drawCellClusters(palette);

        // LAYER 5: Tendrils and membranes (connecting organic lines)
        this.drawOrganicConnections(palette);

        // LAYER 6: Accent details (30-50 small dots, nuclei)
        this.drawMicroscopicDetails(palette);

        // LAYER 7: Black scratchy lines (expressive linear accents)
        this.drawScratchyLines(palette);

        // LAYER 8: Hatching and crosshatch texture
        this.drawHatchingDetails(palette);

        // LAYER 9: Final grain overlay for cohesion
        this.drawFinalGrainOverlay();

        // FINAL: Draw black border as part of artwork (scales with canvas)
        this.drawBorder();

        return this.canvas;
    }

    /**
     * Generate print-ready version (white border only, NO black frame)
     * For Printful and other print services
     */
    generateForPrint() {
        // Clear canvas with off-white background
        this.ctx.fillStyle = '#F5F5F0';
        this.ctx.fillRect(0, 0, this.width, this.height);

        // LAYER 0: Paper grain texture base
        this.drawPaperGrain();

        // Build color palette from selections
        const palette = this.buildPalette();
        const compositionStyle = this.getCompositionStyle();

        // LAYER 1-9: All artwork layers
        this.drawColorWashes(palette);
        this.drawLargeOrganicForms(palette, compositionStyle);
        this.drawPrimaryBiomorphicForms(palette, compositionStyle);
        this.drawCellClusters(palette);
        this.drawOrganicConnections(palette);
        this.drawMicroscopicDetails(palette);
        this.drawScratchyLines(palette);
        this.drawHatchingDetails(palette);
        this.drawFinalGrainOverlay();

        // PRINT VERSION: White border only (no black frame)
        this.drawWhiteBorderOnly();

        return this.canvas;
    }

    /**
     * Draw border with white mat for fine art presentation
     * Creates gallery-quality framing: outer black frame + inner white mat + artwork
     */
    drawBorder() {
        const blackFrameWidth = 30; // Outer black frame
        const whiteMatWidth = 50;   // White mat (passepartout)

        // Draw white mat first
        this.ctx.fillStyle = '#FFFFFF';
        this.ctx.fillRect(0, 0, this.width, whiteMatWidth); // Top
        this.ctx.fillRect(0, this.height - whiteMatWidth, this.width, whiteMatWidth); // Bottom
        this.ctx.fillRect(0, 0, whiteMatWidth, this.height); // Left
        this.ctx.fillRect(this.width - whiteMatWidth, 0, whiteMatWidth, this.height); // Right

        // Draw black frame on top
        this.ctx.strokeStyle = '#000000';
        this.ctx.lineWidth = blackFrameWidth;
        this.ctx.strokeRect(
            blackFrameWidth / 2,
            blackFrameWidth / 2,
            this.width - blackFrameWidth,
            this.height - blackFrameWidth
        );
    }

    /**
     * Draw white border only (for print-ready exports)
     * No black frame - just clean white mat around artwork
     */
    drawWhiteBorderOnly() {
        const whiteMatWidth = 60; // Slightly wider for print

        this.ctx.fillStyle = '#FFFFFF';
        this.ctx.fillRect(0, 0, this.width, whiteMatWidth); // Top
        this.ctx.fillRect(0, this.height - whiteMatWidth, this.width, whiteMatWidth); // Bottom
        this.ctx.fillRect(0, 0, whiteMatWidth, this.height); // Left
        this.ctx.fillRect(this.width - whiteMatWidth, 0, whiteMatWidth, this.height); // Right
    }

    /**
     * Build color palette with VIBRANT, eye-catching colors
     * Enhanced for psychological appeal and visual impact
     */
    buildPalette() {
        const primaryColor = this.selections.color.hex;
        const palette = [];

        // Primary color dominant (5 copies for 60% usage)
        for (let i = 0; i < 5; i++) {
            palette.push(primaryColor);
        }

        // Generate VIBRANT tints and accents (increased saturation)
        const hsl = this.hexToHSL(primaryColor);

        // BRIGHTER tint (+20% saturation for visual appeal)
        palette.push(this.hslToHex(hsl.h, Math.min(100, hsl.s + 20), Math.min(90, hsl.l + 20)));

        // VIVID complementary (high saturation for drama)
        palette.push(this.hslToHex((hsl.h + 180) % 360, Math.min(100, hsl.s + 25), hsl.l));

        // WARM analogous (attracts eye - evolutionary psychology)
        palette.push(this.hslToHex((hsl.h + 30) % 360, Math.min(100, hsl.s + 15), Math.min(85, hsl.l + 10)));

        // BOLD accent (high contrast for focal point)
        palette.push(this.hslToHex((hsl.h + 120) % 360, 95, 65));

        return palette;
    }

    /**
     * Determine composition style from biomorphic form selection
     */
    getCompositionStyle() {
        const shapeKey = this.selections.shape.key;

        const styles = {
            cell: 'clustered',           // Dense groupings
            amoeba: 'fluid',             // Flowing, irregular
            pod: 'scattered',            // Separated clusters
            tendril: 'linear',           // Linear connections
            blob: 'chaotic',             // Random distribution
            nucleus: 'centered',         // Radial from center
            membrane: 'layered',         // Overlapping zones
            spore: 'dispersed',          // Spreading outward
            cyst: 'isolated',            // Separate islands
            embryo: 'nested',            // Concentric forms
            flagellum: 'directional',    // Oriented movement
            chromosome: 'coiled'         // Twisted, intertwined
        };

        return styles[shapeKey] || 'fluid';
    }

    // ======= LAYER 0: PAPER GRAIN TEXTURE =======

    drawPaperGrain() {
        const imageData = this.ctx.getImageData(0, 0, this.width, this.height);
        const data = imageData.data;

        for (let i = 0; i < data.length; i += 4) {
            // Add subtle noise to each pixel
            const noise = (this.random() - 0.5) * 12;
            data[i] = Math.min(255, Math.max(0, data[i] + noise));     // R
            data[i + 1] = Math.min(255, Math.max(0, data[i + 1] + noise)); // G
            data[i + 2] = Math.min(255, Math.max(0, data[i + 2] + noise)); // B
        }

        this.ctx.putImageData(imageData, 0, 0);

        // Add visible grain lines
        for (let i = 0; i < 200; i++) {
            const x = this.random() * this.width;
            const y = this.random() * this.height;
            const length = 20 + this.random() * 80;
            const angle = this.random() * Math.PI * 2;

            this.ctx.strokeStyle = `rgba(0, 0, 0, ${0.02 + this.random() * 0.03})`;
            this.ctx.lineWidth = 0.5 + this.random() * 0.5;
            this.ctx.beginPath();
            this.ctx.moveTo(x, y);
            this.ctx.lineTo(x + Math.cos(angle) * length, y + Math.sin(angle) * length);
            this.ctx.stroke();
        }
    }

    // ======= LAYER 1: SOFT WASH BACKGROUNDS =======

    drawColorWashes(palette) {
        const washCount = 2 + Math.floor(this.random() * 2); // 2-3 washes (reduced)

        for (let i = 0; i < washCount; i++) {
            const x = this.width * (0.2 + this.random() * 0.6);
            const y = this.height * (0.2 + this.random() * 0.6);
            const radiusX = 400 + this.random() * 800;  // Reduced from 600-2000
            const radiusY = 300 + this.random() * 600;  // Reduced from 400-1600
            const color = palette[i % palette.length];

            // Create organic radial gradient
            const gradient = this.ctx.createRadialGradient(x, y, 0, x, y, Math.max(radiusX, radiusY));
            gradient.addColorStop(0, this.addAlpha(color, 0.10));  // Reduced opacity
            gradient.addColorStop(0.5, this.addAlpha(color, 0.05));
            gradient.addColorStop(1, this.addAlpha(color, 0));

            this.ctx.fillStyle = gradient;

            // Draw irregular organic shape instead of perfect circle
            this.drawBlobShape(x, y, radiusX, radiusY, 8);
            this.ctx.fill();
        }
    }

    // ======= LAYER 2: LARGE ORGANIC FORMS =======

    drawLargeOrganicForms(palette, style) {
        const formCount = 3 + Math.floor(this.random() * 3); // 3-5 forms (reduced from 5-8)

        for (let i = 0; i < formCount; i++) {
            const x = this.width * (0.2 + this.random() * 0.6);  // More centered
            const y = this.height * (0.2 + this.random() * 0.6);
            const size = 150 + this.random() * 250;  // Reduced from 300-800
            const color = palette[i % palette.length];

            this.ctx.save();
            this.ctx.fillStyle = this.addAlpha(color, 0.08 + this.random() * 0.10);  // More subtle
            this.ctx.strokeStyle = this.addAlpha(color, 0.18);
            this.ctx.lineWidth = 1 + this.random() * 1.5;

            this.drawBlobShape(x, y, size, size * (0.7 + this.random() * 0.6), 12);
            this.ctx.fill();
            if (this.random() > 0.6) this.ctx.stroke();

            this.ctx.restore();
        }
    }

    // ======= LAYER 3: PRIMARY BIOMORPHIC FORMS =======

    drawPrimaryBiomorphicForms(palette, style) {
        const count = this.selections.number.value;
        const formType = this.selections.shape.key;
        const primaryColor = this.selections.color.hex;

        // Draw HERO biomorphic form - refined size
        const heroSize = 400 + this.random() * 200; // Reduced from 800-1000 to 400-600
        const heroY = this.height * 0.4;
        const heroX = this.width / 2;

        this.ctx.save();
        this.drawBiomorphicForm(formType, heroX, heroY, heroSize, primaryColor, 0.75);
        this.ctx.restore();

        // Draw 2-3 secondary instances (smaller)
        const secondaryCount = Math.min(3, Math.max(2, Math.floor(count / 3)));

        for (let i = 0; i < secondaryCount; i++) {
            const position = this.getOrganicPosition(i, secondaryCount, style);
            const size = 120 + this.random() * 180; // Reduced from 250-550 to 120-300

            this.ctx.save();
            this.drawBiomorphicForm(formType, position.x, position.y, size, primaryColor, 0.55 + this.random() * 0.2);
            this.ctx.restore();
        }
    }

    // ======= LAYER 4: CELL CLUSTERS =======

    drawCellClusters(palette) {
        const cellCount = 12 + Math.floor(this.random() * 12); // 12-24 cells (reduced from 20-40)

        for (let i = 0; i < cellCount; i++) {
            const x = this.width * (0.15 + this.random() * 0.7);
            const y = this.height * (0.15 + this.random() * 0.7);
            const size = 25 + this.random() * 60;  // Reduced from 40-160
            const color = palette[Math.floor(this.random() * palette.length)];

            this.ctx.save();
            this.ctx.fillStyle = this.addAlpha(color, 0.25 + this.random() * 0.3);
            this.ctx.strokeStyle = this.addAlpha(color, 0.4);
            this.ctx.lineWidth = 0.5 + this.random() * 1;

            // Draw organic cell-like blob
            this.drawBlobShape(x, y, size, size * (0.8 + this.random() * 0.4), 6);
            this.ctx.fill();
            if (this.random() > 0.4) this.ctx.stroke();

            this.ctx.restore();
        }
    }

    // ======= LAYER 5: ORGANIC CONNECTIONS =======

    drawOrganicConnections(palette) {
        const connectionCount = 15 + Math.floor(this.random() * 11); // 15-25 connections

        for (let i = 0; i < connectionCount; i++) {
            const x1 = this.width * (0.1 + this.random() * 0.8);
            const y1 = this.height * (0.1 + this.random() * 0.8);
            const x2 = this.width * (0.1 + this.random() * 0.8);
            const y2 = this.height * (0.1 + this.random() * 0.8);
            const color = palette[i % palette.length];

            this.ctx.strokeStyle = this.addAlpha(color, 0.2 + this.random() * 0.3);
            this.ctx.lineWidth = 0.5 + this.random() * 4;
            this.ctx.lineCap = 'round';

            // Draw organic curved connection
            this.ctx.beginPath();
            const cx1 = x1 + (x2 - x1) * 0.3 + (this.random() - 0.5) * 400;
            const cy1 = y1 + (y2 - y1) * 0.3 + (this.random() - 0.5) * 400;
            const cx2 = x1 + (x2 - x1) * 0.7 + (this.random() - 0.5) * 400;
            const cy2 = y1 + (y2 - y1) * 0.7 + (this.random() - 0.5) * 400;

            this.ctx.moveTo(x1, y1);
            this.ctx.bezierCurveTo(cx1, cy1, cx2, cy2, x2, y2);
            this.ctx.stroke();
        }
    }

    // ======= LAYER 6: MICROSCOPIC DETAILS =======

    drawMicroscopicDetails(palette) {
        const detailCount = 30 + Math.floor(this.random() * 21); // 30-50 details

        for (let i = 0; i < detailCount; i++) {
            const x = this.width * (0.05 + this.random() * 0.9);
            const y = this.height * (0.05 + this.random() * 0.9);
            const radius = 2 + this.random() * 25;
            const color = palette[i % palette.length];

            if (this.random() > 0.5) {
                // Filled nucleus
                this.ctx.fillStyle = this.addAlpha(color, 0.5 + this.random() * 0.5);
                this.ctx.beginPath();
                this.ctx.arc(x, y, radius, 0, Math.PI * 2);
                this.ctx.fill();
            } else {
                // Outlined membrane
                this.ctx.strokeStyle = this.addAlpha(color, 0.6 + this.random() * 0.4);
                this.ctx.lineWidth = 0.5 + this.random() * 1.5;
                this.ctx.beginPath();
                this.ctx.arc(x, y, radius, 0, Math.PI * 2);
                this.ctx.stroke();
            }
        }
    }

    // ======= LAYER 7: SCRATCHY BLACK LINES =======

    drawScratchyLines(palette) {
        const lineCount = 8 + Math.floor(this.random() * 12); // 8-20 scratchy lines

        for (let i = 0; i < lineCount; i++) {
            const x1 = this.width * (this.random() * 1.2 - 0.1);
            const y1 = this.height * (this.random() * 1.2 - 0.1);
            const x2 = x1 + (this.random() - 0.5) * 800;
            const y2 = y1 + (this.random() - 0.5) * 800;

            this.ctx.strokeStyle = this.addAlpha('#1A1A1A', 0.4 + this.random() * 0.5);
            this.ctx.lineWidth = 0.5 + this.random() * 2.5;
            this.ctx.lineCap = 'round';

            // Draw scratchy, irregular line
            this.ctx.beginPath();
            this.ctx.moveTo(x1, y1);

            // Add random jitter for scratchy effect
            const segments = 5 + Math.floor(this.random() * 8);
            for (let j = 1; j <= segments; j++) {
                const t = j / segments;
                const x = x1 + (x2 - x1) * t + (this.random() - 0.5) * 40;
                const y = y1 + (y2 - y1) * t + (this.random() - 0.5) * 40;
                this.ctx.lineTo(x, y);
            }

            this.ctx.stroke();
        }
    }

    // ======= LAYER 8: HATCHING DETAILS =======

    drawHatchingDetails(palette) {
        const hatchCount = 12 + Math.floor(this.random() * 10); // 12-22 hatched areas

        for (let i = 0; i < hatchCount; i++) {
            const x = this.width * (0.1 + this.random() * 0.8);
            const y = this.height * (0.1 + this.random() * 0.8);
            const size = 80 + this.random() * 200;
            const angle = this.random() * Math.PI;
            const lineCount = 8 + Math.floor(this.random() * 15);
            const color = palette[i % palette.length];

            this.ctx.save();
            this.ctx.translate(x, y);
            this.ctx.rotate(angle);

            // Draw parallel hatching lines
            const spacing = size / lineCount;
            for (let j = 0; j < lineCount; j++) {
                const offset = (j - lineCount / 2) * spacing;
                const lineLength = size * (0.5 + this.random() * 0.5);

                this.ctx.strokeStyle = this.addAlpha(color, 0.15 + this.random() * 0.2);
                this.ctx.lineWidth = 0.5 + this.random() * 1.5;
                this.ctx.beginPath();
                this.ctx.moveTo(-lineLength / 2, offset);
                this.ctx.lineTo(lineLength / 2, offset);
                this.ctx.stroke();
            }

            // Optional crosshatch (30% chance)
            if (this.random() > 0.7) {
                this.ctx.rotate(Math.PI / 3 + this.random() * 0.5);
                for (let j = 0; j < lineCount / 2; j++) {
                    const offset = (j - lineCount / 4) * spacing * 1.5;
                    const lineLength = size * 0.4;

                    this.ctx.strokeStyle = this.addAlpha(color, 0.1 + this.random() * 0.15);
                    this.ctx.lineWidth = 0.3 + this.random() * 0.8;
                    this.ctx.beginPath();
                    this.ctx.moveTo(-lineLength / 2, offset);
                    this.ctx.lineTo(lineLength / 2, offset);
                    this.ctx.stroke();
                }
            }

            this.ctx.restore();
        }
    }

    // ======= LAYER 9: FINAL GRAIN OVERLAY =======

    drawFinalGrainOverlay() {
        // Add subtle stippling effect
        const dotCount = 3000 + Math.floor(this.random() * 2000);

        for (let i = 0; i < dotCount; i++) {
            const x = this.random() * this.width;
            const y = this.random() * this.height;
            const radius = 0.5 + this.random() * 1.5;

            // Mix of light and dark dots for texture
            if (this.random() > 0.5) {
                this.ctx.fillStyle = `rgba(0, 0, 0, ${0.02 + this.random() * 0.04})`;
            } else {
                this.ctx.fillStyle = `rgba(255, 255, 255, ${0.03 + this.random() * 0.05})`;
            }

            this.ctx.beginPath();
            this.ctx.arc(x, y, radius, 0, Math.PI * 2);
            this.ctx.fill();
        }

        // Add relief shadows to edges
        this.ctx.save();
        this.ctx.globalCompositeOperation = 'multiply';

        // Subtle vignette for depth
        const gradient = this.ctx.createRadialGradient(
            this.width / 2, this.height / 2, this.height * 0.3,
            this.width / 2, this.height / 2, this.height * 0.8
        );
        gradient.addColorStop(0, 'rgba(255, 255, 255, 0)');
        gradient.addColorStop(1, 'rgba(0, 0, 0, 0.06)');
        this.ctx.fillStyle = gradient;
        this.ctx.fillRect(0, 0, this.width, this.height);

        this.ctx.restore();
    }

    // ======= BIOMORPHIC DRAWING FUNCTIONS =======

    drawBlobShape(x, y, radiusX, radiusY, points) {
        this.ctx.beginPath();

        for (let i = 0; i <= points; i++) {
            const angle = (i / points) * Math.PI * 2;
            const variation = 0.7 + this.random() * 0.6; // Organic variation
            const px = x + Math.cos(angle) * radiusX * variation;
            const py = y + Math.sin(angle) * radiusY * variation;

            if (i === 0) {
                this.ctx.moveTo(px, py);
            } else {
                // Use curves for organic smoothness
                const prevAngle = ((i - 1) / points) * Math.PI * 2;
                const prevVariation = 0.7 + this.random() * 0.6;
                const cpx = x + Math.cos((prevAngle + angle) / 2) * radiusX * prevVariation;
                const cpy = y + Math.sin((prevAngle + angle) / 2) * radiusY * prevVariation;
                this.ctx.quadraticCurveTo(cpx, cpy, px, py);
            }
        }

        this.ctx.closePath();
    }

    drawBiomorphicForm(type, x, y, size, color, alpha) {
        const darkColor = this.darkenColor(color, 0.3);

        // Add subtle shadow/relief effect
        this.ctx.save();
        this.ctx.shadowColor = 'rgba(0, 0, 0, 0.15)';
        this.ctx.shadowBlur = size / 15;
        this.ctx.shadowOffsetX = size / 40;
        this.ctx.shadowOffsetY = size / 40;

        this.ctx.fillStyle = this.addAlpha(color, alpha);
        this.ctx.strokeStyle = this.addAlpha(darkColor, alpha * 1.2);
        this.ctx.lineWidth = 1 + size / 200;

        switch (type) {
            case 'cell':
                this.drawCell(x, y, size);
                break;
            case 'amoeba':
                this.drawAmoeba(x, y, size);
                break;
            case 'pod':
                this.drawPod(x, y, size);
                break;
            case 'tendril':
                this.drawTendril(x, y, size);
                break;
            case 'blob':
                this.drawBlob(x, y, size);
                break;
            case 'nucleus':
                this.drawNucleus(x, y, size);
                break;
            case 'membrane':
                this.drawMembrane(x, y, size);
                break;
            case 'spore':
                this.drawSpore(x, y, size);
                break;
            case 'cyst':
                this.drawCyst(x, y, size);
                break;
            case 'embryo':
                this.drawEmbryo(x, y, size);
                break;
            case 'flagellum':
                this.drawFlagellum(x, y, size);
                break;
            case 'chromosome':
                this.drawChromosome(x, y, size);
                break;
            default:
                this.drawBlob(x, y, size);
        }

        this.ctx.restore(); // Restore from shadow save
    }

    // Individual biomorphic forms

    drawCell(x, y, size) {
        // Circular cell with nucleus
        this.drawBlobShape(x, y, size / 2, size / 2, 8);
        this.ctx.fill();
        this.ctx.stroke();

        // Inner nucleus
        this.ctx.fillStyle = this.addAlpha(this.ctx.strokeStyle, 0.6);
        this.ctx.beginPath();
        this.ctx.arc(x, y, size / 5, 0, Math.PI * 2);
        this.ctx.fill();
    }

    drawAmoeba(x, y, size) {
        // Highly irregular blob with pseudopods
        this.drawBlobShape(x, y, size / 2, size / 2.2, 12);
        this.ctx.fill();
        this.ctx.stroke();
    }

    drawPod(x, y, size) {
        // Elongated oval shape
        this.ctx.save();
        this.ctx.translate(x, y);
        this.ctx.rotate(this.random() * Math.PI * 2);
        this.drawBlobShape(0, 0, size / 2.5, size / 1.8, 8);
        this.ctx.fill();
        this.ctx.stroke();
        this.ctx.restore();
    }

    drawTendril(x, y, size) {
        // Curving tendril
        this.ctx.beginPath();
        this.ctx.moveTo(x, y);
        const endX = x + (this.random() - 0.5) * size * 2;
        const endY = y + (this.random() - 0.5) * size * 2;
        const cp1x = x + (this.random() - 0.5) * size;
        const cp1y = y + (this.random() - 0.5) * size;
        const cp2x = x + (this.random() - 0.5) * size * 1.5;
        const cp2y = y + (this.random() - 0.5) * size * 1.5;
        this.ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, endX, endY);
        this.ctx.lineWidth = size / 15;
        this.ctx.stroke();
    }

    drawBlob(x, y, size) {
        // Pure irregular blob
        this.drawBlobShape(x, y, size / 2, size / 2.3, 10);
        this.ctx.fill();
        this.ctx.stroke();
    }

    drawNucleus(x, y, size) {
        // Dense center with radiating elements
        this.ctx.beginPath();
        this.ctx.arc(x, y, size / 2.5, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.stroke();

        // Radiating dots
        for (let i = 0; i < 8; i++) {
            const angle = (i / 8) * Math.PI * 2;
            const dist = size / 2;
            const px = x + Math.cos(angle) * dist;
            const py = y + Math.sin(angle) * dist;
            this.ctx.beginPath();
            this.ctx.arc(px, py, size / 15, 0, Math.PI * 2);
            this.ctx.fill();
        }
    }

    drawMembrane(x, y, size) {
        // Double membrane outline
        this.drawBlobShape(x, y, size / 2, size / 2, 10);
        this.ctx.stroke();

        this.drawBlobShape(x, y, size / 2.5, size / 2.5, 10);
        this.ctx.stroke();
    }

    drawSpore(x, y, size) {
        // Small dense spore with tail
        this.ctx.beginPath();
        this.ctx.arc(x, y, size / 3, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.stroke();

        // Tail
        this.ctx.beginPath();
        this.ctx.moveTo(x, y);
        this.ctx.quadraticCurveTo(
            x + size / 4, y + size / 2,
            x + size / 6, y + size
        );
        this.ctx.stroke();
    }

    drawCyst(x, y, size) {
        // Enclosed protective form
        this.ctx.save();
        this.ctx.globalAlpha = 0.7;
        this.drawBlobShape(x, y, size / 2.2, size / 2.2, 6);
        this.ctx.fill();
        this.ctx.globalAlpha = 1;
        this.ctx.stroke();
        this.ctx.restore();
    }

    drawEmbryo(x, y, size) {
        // Nested forms
        for (let i = 0; i < 3; i++) {
            const scale = 1 - (i * 0.25);
            this.drawBlobShape(x, y, size / 2 * scale, size / 2.2 * scale, 8);
            this.ctx.stroke();
        }
    }

    drawFlagellum(x, y, size) {
        // Whipping tail-like form
        this.ctx.beginPath();
        this.ctx.moveTo(x, y);
        for (let i = 0; i < 8; i++) {
            const t = i / 8;
            const wave = Math.sin(t * Math.PI * 3) * size / 4;
            const px = x + t * size;
            const py = y + wave;
            this.ctx.lineTo(px, py);
        }
        this.ctx.lineWidth = size / 20;
        this.ctx.stroke();
    }

    drawChromosome(x, y, size) {
        // X-shaped coiled form
        this.ctx.save();
        this.ctx.translate(x, y);

        // Draw two crossing curves
        this.ctx.beginPath();
        this.ctx.moveTo(-size / 3, -size / 3);
        this.ctx.quadraticCurveTo(0, 0, size / 3, size / 3);
        this.ctx.stroke();

        this.ctx.beginPath();
        this.ctx.moveTo(size / 3, -size / 3);
        this.ctx.quadraticCurveTo(0, 0, -size / 3, size / 3);
        this.ctx.stroke();

        this.ctx.restore();
    }

    // Position helpers

    getOrganicPosition(index, total, style) {
        const centerX = this.width / 2;
        const centerY = this.height / 2;

        switch (style) {
            case 'clustered':
                return {
                    x: centerX + (this.random() - 0.5) * 800,
                    y: centerY + (this.random() - 0.5) * 600
                };

            case 'fluid':
                return {
                    x: this.width * (0.2 + this.random() * 0.6),
                    y: this.height * (0.2 + this.random() * 0.6)
                };

            case 'centered':
                const angle = (Math.PI * 2 * index) / total;
                const radius = 200 + this.random() * 300;
                return {
                    x: centerX + Math.cos(angle) * radius,
                    y: centerY + Math.sin(angle) * radius
                };

            default:
                return {
                    x: this.width * (0.15 + this.random() * 0.7),
                    y: this.height * (0.15 + this.random() * 0.7)
                };
        }
    }

    // Color utilities

    darkenColor(hex, amount) {
        const hsl = this.hexToHSL(hex);
        return this.hslToHex(hsl.h, hsl.s, Math.max(0, hsl.l - amount * 100));
    }

    hexToHSL(hex) {
        let r = 0, g = 0, b = 0;
        if (hex.length === 7) {
            r = parseInt(hex.slice(1, 3), 16) / 255;
            g = parseInt(hex.slice(3, 5), 16) / 255;
            b = parseInt(hex.slice(5, 7), 16) / 255;
        }

        const max = Math.max(r, g, b);
        const min = Math.min(r, g, b);
        let h = 0, s = 0, l = (max + min) / 2;

        if (max !== min) {
            const d = max - min;
            s = l > 0.5 ? d / (2 - max - min) : d / (max + min);

            switch (max) {
                case r: h = ((g - b) / d + (g < b ? 6 : 0)) / 6; break;
                case g: h = ((b - r) / d + 2) / 6; break;
                case b: h = ((r - g) / d + 4) / 6; break;
            }
        }

        return { h: h * 360, s: s * 100, l: l * 100 };
    }

    hslToHex(h, s, l) {
        s /= 100;
        l /= 100;

        const c = (1 - Math.abs(2 * l - 1)) * s;
        const x = c * (1 - Math.abs((h / 60) % 2 - 1));
        const m = l - c / 2;

        let r = 0, g = 0, b = 0;

        if (h >= 0 && h < 60) { r = c; g = x; b = 0; }
        else if (h >= 60 && h < 120) { r = x; g = c; b = 0; }
        else if (h >= 120 && h < 180) { r = 0; g = c; b = x; }
        else if (h >= 180 && h < 240) { r = 0; g = x; b = c; }
        else if (h >= 240 && h < 300) { r = x; g = 0; b = c; }
        else if (h >= 300 && h < 360) { r = c; g = 0; b = x; }

        const toHex = (val) => {
            const hex = Math.round((val + m) * 255).toString(16);
            return hex.length === 1 ? '0' + hex : hex;
        };

        return `#${toHex(r)}${toHex(g)}${toHex(b)}`;
    }

    addAlpha(hex, alpha) {
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }
}
